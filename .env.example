# Copy this file to .env and fill in the values. NEVER commit .env.

# JWT signing key — REQUIRED. Generate a strong random value once:
#   python -c "import secrets; print(secrets.token_hex(32))"
KANBAN_SECRET_KEY=

# Allowed browser origins (comma-separated). "*" is acceptable on a private
# Tailscale network; tighten it if you expose the app publicly.
KANBAN_CORS_ORIGINS=*

# Web Push notifications (optional). Generate a keypair once:
#   cd server && python gen_vapid.py >> ../.env
# Leave empty to disable push. Keep the private key secret.
KANBAN_VAPID_PUBLIC_KEY=
KANBAN_VAPID_PRIVATE_KEY=
KANBAN_VAPID_SUBJECT=mailto:you@example.com

# Only needed if you use the Tailscale sidecar in docker-compose.yml.
# TS_AUTHKEY=
