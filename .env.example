# Copy this file to .env and fill in the values. NEVER commit .env.

# JWT signing key — REQUIRED. Generate a strong random value once:
#   python -c "import secrets; print(secrets.token_hex(32))"
KANBAN_SECRET_KEY=

# Allowed browser origins (comma-separated). "*" is acceptable on a private
# Tailscale network; tighten it if you expose the app publicly.
KANBAN_CORS_ORIGINS=*

# Web Push notifications (optional). Generate a keypair once:
#   cd server && python gen_vapid.py >> ../.env
# Leave empty to disable push. Keep the private key secret.
KANBAN_VAPID_PUBLIC_KEY=
KANBAN_VAPID_PRIVATE_KEY=
KANBAN_VAPID_SUBJECT=mailto:you@example.com

# AI planner (optional). Choose a provider: "anthropic" (Claude cloud) or
# "ollama" (local model on your NAS — no API key, fully private).
KANBAN_AI_PROVIDER=anthropic

# --- Option A: Anthropic (Claude). Key stays server-side, never sent to the browser.
KANBAN_ANTHROPIC_API_KEY=
KANBAN_ANTHROPIC_MODEL=claude-opus-4-8

# --- Option B: Ollama (set KANBAN_AI_PROVIDER=ollama above).
# If Ollama runs on the NAS host, the default host.docker.internal reaches it.
# Or point to another machine, e.g. http://192.168.0.50:11434
KANBAN_OLLAMA_URL=http://host.docker.internal:11434
KANBAN_OLLAMA_MODEL=llama3.1

# Only needed if you use the Tailscale sidecar in docker-compose.yml.
# TS_AUTHKEY=
