# Copy this file to .env and fill in the values. NEVER commit .env.

# JWT signing key — REQUIRED. Generate a strong random value once:
#   python -c "import secrets; print(secrets.token_hex(32))"
KANBAN_SECRET_KEY=

# Allowed browser origins (comma-separated). "*" is acceptable on a private
# Tailscale network; tighten it if you expose the app publicly.
KANBAN_CORS_ORIGINS=*

